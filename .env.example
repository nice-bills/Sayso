# --- Airwallex sandbox: Account > Developer > API keys at sandbox.airwallex.com ---
AWX_CLIENT_ID=
AWX_API_KEY=
AWX_BASE_URL=https://api.sandbox.airwallex.com
# Filled in by `npm run setup:airwallex`
AWX_GLOBAL_ACCOUNT_ID=
AWX_BEN_LANDLORD=
AWX_BEN_CONTRACTOR=
AWX_BEN_DESIGNER=
AWX_BEN_VENDOR=
# Optional: reuse an existing card instead of issuing one per demo run
AWX_CARD_ID=
# Optional: the webhook endpoint's secret, when /webhooks/airwallex is reachable from Airwallex
AWX_WEBHOOK_SECRET=

# --- Metal testnet: create an RPC endpoint at https://console-testnet.metalntwx.com ---
METAL_RPC_URL=
METAL_NETWORK=testnet
# Filled in by `npm run setup:metal`
METAL_PRINCIPAL=
METAL_SELLER_ADDRESS=
METAL_RAMP_ADDRESS=
METAL_OWNER_KEY=.metal/owner.json
METAL_MANDATE=.metal/mandate.json
METAL_BUYER_KEYS=
# Optional: seller token Metal issues for clearing-debit (sub-cent prices)
METAL_SELLER_TOKEN=

# --- Optional: Claude reads inbound email. Without it, a conservative keyword reader is used. ---
ANTHROPIC_API_KEY=

# --- Local ---
COINSLOT_DB=coinslot.db
DASHBOARD_PORT=4300
