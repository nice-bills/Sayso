# Airwallex sandbox: Account > Developer > API keys at sandbox.airwallex.com
AWX_CLIENT_ID=
AWX_API_KEY=
AWX_BASE_URL=https://api.sandbox.airwallex.com

# Metal testnet: create an endpoint at https://console-testnet.metalntwx.com
METAL_RPC_URL=
# The agent's seller address (receives x402 payments)
METAL_SELLER_ADDRESS=
# Optional: seller token Metal issues for clearing-debit
METAL_SELLER_TOKEN=
# Comma-separated private keys of buyer agents in the swarm (testnet only)
METAL_BUYER_KEYS=

ANTHROPIC_API_KEY=
