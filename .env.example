# --- Airwallex sandbox: Account > Developer > API keys at sandbox.airwallex.com ---
AWX_CLIENT_ID=
AWX_API_KEY=
AWX_BASE_URL=https://api.sandbox.airwallex.com
# Filled in by `npm run setup:airwallex`
AWX_GLOBAL_ACCOUNT_ID=
AWX_BEN_LANDLORD=
AWX_BEN_CONTRACTOR=
AWX_BEN_DESIGNER=
AWX_BEN_VENDOR=
# Optional: reuse an existing card instead of issuing one per demo run
AWX_CARD_ID=
# Optional: the webhook endpoint's secret, when /webhooks/airwallex is reachable from Airwallex
AWX_WEBHOOK_SECRET=
# Payee name matching (Verification/Confirmation of Payee). Default: on, except on the sandbox, which never matches a name.
AWX_NAME_CHECK=

# --- Metal testnet: create an RPC endpoint at https://console-testnet.metalntwx.com ---
METAL_RPC_URL=
METAL_NETWORK=testnet
# Filled in by `npm run setup:metal`
METAL_PRINCIPAL=
METAL_RAMP_ADDRESS=
METAL_OWNER_KEY=.metal/owner.json
METAL_MANDATE=.metal/mandate.json
METAL_REFUND_MANDATE=.metal/refund.json
# Testnet keys of the demo's buyer agents (they pay Sayso over x402)
METAL_BUYER_KEYS=
# Optional: seller token Metal issues for clearing-debit (sub-cent prices)
METAL_SELLER_TOKEN=

# --- Optional: Claude reads and extracts invoices. Without it, conservative pattern rules are used. ---
ANTHROPIC_API_KEY=

# --- Optional: the invoice inbox reads a mailbox over IMAP (a Gmail with an app password works) ---
INBOX_IMAP_HOST=
INBOX_IMAP_PORT=993
INBOX_IMAP_USER=
INBOX_IMAP_PASS=

# --- MCP tool (for agents that pay through Sayso) ---
SAYSO_URL=http://127.0.0.1:4021
SAYSO_BUYER_KEY=
SAYSO_MAX_USDZ=250

# --- Local ---
SAYSO_DB=sayso.db
PORT=4021

# The owner's sign-in for the app (approvals, inbox, back office). Unset: "sayso-demo" offline, random and logged live.
OWNER_TOKEN=
# The owner's email: the address an emailed sign-in link goes to (through AgentMail), and the
# Google account allowed in. Passkeys (Face ID, a fingerprint) work without it.
OWNER_EMAIL=
# "Continue with Google": an OAuth web client whose redirect URI is <PUBLIC_URL>/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Keeps sessions valid across restarts. Unset: a random key per process.
SESSION_SECRET=
# Lets a mail hook (Zapier, a mail rule, a Cloudflare email worker) POST /v1/inbox with x-inbox-secret.
INBOX_SECRET=

# Where people and chat apps reach Sayso (approval links and connector URLs use it).
PUBLIC_URL=
# Phone notifications through ntfy (free, no account): subscribe to a long random topic in the ntfy app.
NTFY_TOPIC=
# Sayso makes its own AgentMail address on first start. With a verified AgentMail account's key it makes the
# address there and can send at once; with no key it signs up alone and OWNER_EMAIL gets a one-time code.
# Add AGENTMAIL_INBOX_ID to use an inbox you already made.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
# Optional: a message.received webhook to PUBLIC_URL/webhooks/agentmail for instant delivery (otherwise Sayso polls).
AGENTMAIL_WEBHOOK_SECRET=
# Set to off to stop Sayso making its own address.
AGENTMAIL_AUTO=

# Receipts anchored on Metal: a funded testnet key (npm run setup:metal prints it). Without it, receipts are simulated (sim:).
METAL_RECEIPT_KEY=
# How agents' Metal mandates are treated: verify (default: check and record them), required (refuse any other payment), off.
SAYSO_AGENT_MANDATES=verify
