{
  "name": "coinslot",
  "version": "0.1.0",
  "description": "An AI agent that sells its service per call on Metal, banks it with Airwallex, and pays its own bills.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo:offline": "tsx src/demo.ts --offline",
    "demo": "tsx --env-file-if-exists=.env src/demo.ts",
    "seller": "tsx --env-file-if-exists=.env src/metal/seller.ts",
    "swarm": "tsx --env-file-if-exists=.env src/metal/swarm.ts",
    "setup:metal": "tsx --env-file-if-exists=.env scripts/setup-metal.ts",
    "setup:airwallex": "tsx --env-file-if-exists=.env scripts/setup-airwallex.ts",
    "smoke:airwallex": "tsx --env-file-if-exists=.env src/airwallex/smoke.ts",
    "fetch-fx": "tsx scripts/fetch-fx.ts",
    "backtest": "tsx scripts/backtest.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@metalntwx/metal-agent": "^0.2.0",
    "@metalntwx/metal-pay": "^0.2.0",
    "@x402/core": "2.21.0",
    "@x402/evm": "2.21.0",
    "@x402/express": "2.21.0",
    "@x402/fetch": "2.21.0",
    "express": "^5.3.0",
    "viem": "^2.57.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
